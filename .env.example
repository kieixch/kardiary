# Neon Postgres. DATABASE_URL should use the pooled host for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct/unpooled host, used by Prisma migrations during deployment.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local SQLite database used by `npm run dev`.
# The path is relative to prisma/schema.sqlite.prisma.
LOCAL_DATABASE_URL="file:../data/kardiary.db"

# Password gate. Generate the secret with: openssl rand -base64 32
KARDIARY_PASSWORD="change-me"
KARDIARY_SESSION_SECRET="change-me-to-a-long-random-value"

# Cloudflare R2 (S3-compatible). Required on Vercel.
# Use the 32-character account ID, not the dashboard URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional override, for example an S3-compatible endpoint.
# R2_ENDPOINT=""

# Optional local upload override (dev only; defaults to ./data/uploads).
# KARDIARY_UPLOAD_DIR="data/uploads"
